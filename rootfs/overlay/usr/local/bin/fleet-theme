#!/bin/bash
# Switch the KidsOS colours.   fleet-theme            (pick from a list)
#                              fleet-theme list
#                              fleet-theme set <id>   (sol hav)
# Only changes settings (GTK theme, window frame, wallpaper, panel colour): no extra services, no cost at runtime.
D=/usr/share/fleet-themes
CUR="$HOME/.config/fleet-theme"

field() { grep -m1 "^$2=" "$D/$1.conf" | cut -d= -f2-; }
ids()   { for f in "$D"/*.conf; do basename "$f" .conf; done; }

apply() {
  id=$1
  [ -f "$D/$id.conf" ] || { echo "unknown theme: $id" >&2; exit 1; }
  gtk=$(field "$id" GTKNAME)
  wall="/usr/share/backgrounds/kidsos/kidsos-$id.svg"
  # fleet-theme-gen links the base theme's xfwm4 window frame into every KidsOS theme
  xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s "$gtk"
  xfconf-query -c xfwm4 -p /general/theme     -n -t string -s "$gtk"

  # Panel plugins that run in their own process (tray, volume, battery) cannot see the GTK panel background and
  # would show the wallpaper through as dark boxes. A solid panel colour is handed to them by the panel itself.
  rgba=$(field "$id" PANEL | sed -n 's/^rgba(\([0-9]*\),\([0-9]*\),\([0-9]*\),.*/\1 \2 \3/p')
  if [ -n "$rgba" ]; then
    set -- $rgba
    xfconf-query -c xfce4-panel -p /panels/panel-1/background-style -n -t uint -s 1
    xfconf-query -c xfce4-panel -p /panels/panel-1/background-rgba -n -a \
      -t double -s "$(LC_ALL=C awk "BEGIN{printf \"%.3f\", $1/255}")" -t double -s "$(LC_ALL=C awk "BEGIN{printf \"%.3f\", $2/255}")" \
      -t double -s "$(LC_ALL=C awk "BEGIN{printf \"%.3f\", $3/255}")" -t double -s 1.0
  fi

  # The desktop keeps one wallpaper setting per monitor, named after the output (LVDS-1, eDP-1 ...). A brand new
  # user has none yet, so set every connected output as well as the old-style "monitor0".
  props=$(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E '/last-image$')
  props="$props /backdrop/screen0/monitor0/workspace0/last-image"
  for out in $(xrandr --query 2>/dev/null | awk '/ connected/{print $1}'); do
    props="$props /backdrop/screen0/monitor$out/workspace0/last-image"
  done
  for p in $(printf '%s\n' $props | sort -u); do
    xfconf-query -c xfce4-desktop -p "$p" -n -t string -s "$wall"
    xfconf-query -c xfce4-desktop -p "${p%/last-image}/image-style" -n -t int -s 5
  done
  mkdir -p "$(dirname "$CUR")" && echo "$id" > "$CUR"
}

case "${1:-gui}" in
  list) for i in $(ids); do echo "$i  $(field "$i" LABEL)"; done ;;
  set)  apply "${2:?usage: fleet-theme set <id>}" ;;
  gui)
    args=()
    for i in $(ids); do args+=("$i" "$(field "$i" LABEL)"); done
    sel=$(yad --list --title="Färger" --width=420 --height=320 --center \
          --text="Välj färger" --column=ID:HD --column=Tema --print-column=1 --separator= \
          --button="Avbryt:1" --button="Använd:0" "${args[@]}") || exit 0
    [ -n "$sel" ] && apply "$sel"
    ;;
  *) echo "usage: fleet-theme [list|set <id>|gui]" >&2; exit 1 ;;
esac